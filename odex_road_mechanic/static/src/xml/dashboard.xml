<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odex_road_mechanic.Dashboard">
        <div class="o_orm_dashboard">
            <div class="o_orm_dashboard__header">
                <h2 class="o_orm_dashboard__title">Road Mechanic Directory</h2>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.loadData()">
                    <i class="fa fa-refresh me-1"/>Refresh
                </button>
            </div>

            <div t-if="state.loading" class="o_orm_empty">Loading statistics...</div>

            <t t-else="">
                <div class="o_orm_dashboard__stats">
                    <button class="o_orm_stat" t-on-click="() => this.openAction('odex_road_mechanic.action_workshop')">
                        <span class="o_orm_stat__value" t-esc="state.stats.total_workshops"/>
                        <span class="o_orm_stat__label">Total workshops</span>
                    </button>
                    <button class="o_orm_stat o_orm_stat--green" t-on-click="() => this.openAction('odex_road_mechanic.action_workshop_verified')">
                        <span class="o_orm_stat__value" t-esc="state.stats.verified_workshops"/>
                        <span class="o_orm_stat__label">Verified workshops</span>
                    </button>
                    <button class="o_orm_stat" t-on-click="() => this.openAction('odex_road_mechanic.action_workshop_pending')">
                        <span class="o_orm_stat__value" t-esc="state.stats.pending_verification"/>
                        <span class="o_orm_stat__label">Pending verification</span>
                    </button>
                    <button class="o_orm_stat o_orm_stat--gold" t-on-click="() => this.openAction('odex_road_mechanic.action_workshop_featured')">
                        <span class="o_orm_stat__value" t-esc="state.stats.featured_workshops"/>
                        <span class="o_orm_stat__label">Featured workshops</span>
                    </button>
                    <button class="o_orm_stat o_orm_stat--grey" t-on-click="() => this.openAction('odex_road_mechanic.action_workshop_rejected')">
                        <span class="o_orm_stat__value" t-esc="state.stats.rejected_workshops"/>
                        <span class="o_orm_stat__label">Rejected workshops</span>
                    </button>
                    <button class="o_orm_stat o_orm_stat--green" t-on-click="() => this.openAction('odex_road_mechanic.action_workshop')">
                        <span class="o_orm_stat__value" t-esc="state.stats.published_workshops"/>
                        <span class="o_orm_stat__label">Published on website</span>
                    </button>
                    <button class="o_orm_stat" t-on-click="() => this.openAction('odex_road_mechanic.action_review')">
                        <span class="o_orm_stat__value" t-esc="state.stats.total_reviews"/>
                        <span class="o_orm_stat__label">Total reviews</span>
                    </button>
                    <button class="o_orm_stat o_orm_stat--gold" t-on-click="() => this.openAction('odex_road_mechanic.action_review_pending')">
                        <span class="o_orm_stat__value" t-esc="state.stats.pending_reviews"/>
                        <span class="o_orm_stat__label">Pending reviews</span>
                    </button>
                    <button class="o_orm_stat" t-on-click="() => this.openAction('odex_road_mechanic.action_inquiry')">
                        <span class="o_orm_stat__value" t-esc="state.stats.total_inquiries"/>
                        <span class="o_orm_stat__label">Total inquiries</span>
                    </button>
                    <button class="o_orm_stat o_orm_stat--green" t-on-click="() => this.openAction('odex_road_mechanic.action_inquiry_new')">
                        <span class="o_orm_stat__value" t-esc="state.stats.new_inquiries"/>
                        <span class="o_orm_stat__label">New inquiries</span>
                    </button>
                </div>

                <div class="o_orm_dashboard__lists">
                    <div class="o_orm_panel">
                        <h3>Pending verification</h3>
                        <p t-if="!state.pending_workshops.length" class="o_orm_empty">Nothing waiting for review.</p>
                        <table t-else="">
                            <tbody>
                                <tr t-foreach="state.pending_workshops" t-as="workshop" t-key="workshop.id"
                                    t-on-click="() => this.openRecord('odex.road.mechanic.workshop', workshop.id)"
                                    style="cursor: pointer;">
                                    <td t-esc="workshop.name"/>
                                    <td t-esc="this.formatDate(workshop.create_date)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="o_orm_panel">
                        <h3>Recent registrations</h3>
                        <p t-if="!state.recent_workshops.length" class="o_orm_empty">No workshop yet.</p>
                        <table t-else="">
                            <tbody>
                                <tr t-foreach="state.recent_workshops" t-as="workshop" t-key="workshop.id"
                                    t-on-click="() => this.openRecord('odex.road.mechanic.workshop', workshop.id)"
                                    style="cursor: pointer;">
                                    <td t-esc="workshop.name"/>
                                    <td t-esc="this.formatDate(workshop.create_date)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="o_orm_panel">
                        <h3>Recent reviews</h3>
                        <p t-if="!state.recent_reviews.length" class="o_orm_empty">No review yet.</p>
                        <table t-else="">
                            <tbody>
                                <tr t-foreach="state.recent_reviews" t-as="review" t-key="review.id"
                                    t-on-click="() => this.openRecord('odex.road.mechanic.review', review.id)"
                                    style="cursor: pointer;">
                                    <td>
                                        <t t-esc="review.display_name"/>
                                        <span class="ms-1 text-warning">
                                            <t t-esc="review.rating"/><i class="fa fa-star ms-1"/>
                                        </span>
                                    </td>
                                    <td t-esc="this.formatDate(review.create_date)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="o_orm_panel">
                        <h3>Recent inquiries</h3>
                        <p t-if="!state.recent_inquiries.length" class="o_orm_empty">No inquiry yet.</p>
                        <table t-else="">
                            <tbody>
                                <tr t-foreach="state.recent_inquiries" t-as="inquiry" t-key="inquiry.id"
                                    t-on-click="() => this.openRecord('odex.road.mechanic.inquiry', inquiry.id)"
                                    style="cursor: pointer;">
                                    <td t-esc="inquiry.display_name"/>
                                    <td t-esc="this.formatDate(inquiry.create_date)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
