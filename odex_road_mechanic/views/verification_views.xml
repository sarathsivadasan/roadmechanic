<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_verification_reject_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.verification.reject.form</field>
        <field name="model">odex.road.mechanic.verification.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Workshop">
                <group>
                    <field name="workshop_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Explain why the verification is refused."/>
                    <field name="unpublish"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject Workshop" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
