<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.service.list</field>
        <field name="model">odex.road.mechanic.service</field>
        <field name="arch" type="xml">
            <list string="Services" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="slug" readonly="1"/>
                <field name="workshop_count" string="Workshops"/>
                <field name="show_on_homepage" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_service_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.service.form</field>
        <field name="model">odex.road.mechanic.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workshops" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="workshop_count" widget="statinfo" string="Workshops"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. AC Repair"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="icon" placeholder="fa-snowflake-o"/>
                            <field name="color" placeholder="#e51b23"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="slug" placeholder="Generated from the name"/>
                            <field name="show_on_homepage"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Short description shown on the service page."/>
                    </group>
                    <group string="SEO">
                        <field name="website_meta_title"/>
                        <field name="website_meta_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">odex.road.mechanic.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a service</p>
            <p>Services are shown in the homepage category strip and used as directory filters.</p>
        </field>
    </record>

</odoo>
