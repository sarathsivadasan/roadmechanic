<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_job_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.list</field>
        <field name="model">odex.road.mechanic.job</field>
        <field name="arch" type="xml">
            <list string="Jobs" decoration-info="state == 'pending'"
                  decoration-success="state == 'published'"
                  decoration-muted="state in ('closed', 'expired', 'rejected')">
                <field name="name"/>
                <field name="workshop_id"/>
                <field name="job_category_id"/>
                <field name="job_type"/>
                <field name="experience_label" string="Experience"/>
                <field name="location_label" string="Location"/>
                <field name="application_count" string="Applications"/>
                <field name="application_deadline" optional="show"/>
                <field name="published_date" optional="hide"/>
                <field name="is_featured" widget="boolean_toggle"
                       groups="odex_road_mechanic.group_road_mechanic_manager"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_job_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.form</field>
        <field name="model">odex.road.mechanic.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve &amp; Publish"
                            class="btn-primary" invisible="state != 'pending'"
                            groups="odex_road_mechanic.group_road_mechanic_manager"/>
                    <button name="%(action_job_reject_wizard)d" type="action" string="Reject"
                            invisible="state not in ('pending', 'published')"
                            groups="odex_road_mechanic.group_road_mechanic_manager"/>
                    <button name="action_close" type="object" string="Close Job"
                            invisible="state != 'published'"/>
                    <button name="action_approve" type="object" string="Re-publish"
                            invisible="state not in ('closed', 'expired')"
                            groups="odex_road_mechanic.group_road_mechanic_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="odex_road_mechanic.group_road_mechanic_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,published,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applications" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="application_count" widget="statinfo"
                                   string="Applications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Auto Technician"/></h1>
                    </div>
                    <group>
                        <group string="Company">
                            <field name="workshop_id" options="{'no_create': True}"/>
                            <field name="is_company_verified" readonly="1"/>
                            <field name="job_category_id" options="{'no_create_edit': True}"/>
                            <field name="job_type"/>
                            <field name="skill_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Experience &amp; Location">
                            <label for="experience_min" string="Experience (years)"/>
                            <div class="o_row">
                                <field name="experience_min"/>
                                <span class="mx-2">to</span>
                                <field name="experience_max"/>
                            </div>
                            <field name="experience_label" readonly="1"/>
                            <field name="use_company_location"/>
                            <field name="emirate" invisible="use_company_location"/>
                            <field name="city" invisible="use_company_location"/>
                            <field name="area" invisible="use_company_location"/>
                            <field name="location_id" invisible="use_company_location"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Salary">
                            <field name="salary_type"/>
                            <field name="salary_min"
                                   invisible="salary_type in ('undisclosed', 'negotiable')"/>
                            <field name="salary_max"
                                   invisible="salary_type in ('undisclosed', 'negotiable')"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Applications">
                            <field name="application_method"/>
                            <field name="application_email"/>
                            <field name="application_url"
                                   invisible="application_method != 'url'"
                                   required="application_method == 'url'"/>
                            <field name="application_deadline"/>
                            <field name="allow_reapplication"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the role..."/>
                        </page>
                        <page string="Requirements" name="requirements">
                            <field name="requirements"
                                   placeholder="Minimum 2 years experience, UAE licence..."/>
                        </page>
                        <page string="Contact" name="contact">
                            <group>
                                <field name="contact_person"/>
                                <field name="contact_phone"/>
                                <field name="show_contact"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Contact details stay private unless "Show Contact Publicly"
                                is ticked.
                            </div>
                        </page>
                        <page string="Applications" name="applications">
                            <field name="application_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="applicant_name"/>
                                    <field name="phone"/>
                                    <field name="experience_years"/>
                                    <field name="current_location"/>
                                    <field name="create_date" string="Applied"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Moderation" name="moderation">
                            <group>
                                <group>
                                    <field name="is_featured"
                                           groups="odex_road_mechanic.group_road_mechanic_manager"/>
                                    <field name="priority"
                                           groups="odex_road_mechanic.group_road_mechanic_manager"/>
                                    <field name="published_date" readonly="1"/>
                                    <field name="closed_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                    <field name="rejected_by" readonly="1"/>
                                    <field name="rejected_date" readonly="1"/>
                                </group>
                            </group>
                            <field name="rejection_reason" readonly="1"
                                   invisible="not rejection_reason"/>
                        </page>
                        <page string="Website" name="website">
                            <group>
                                <field name="slug"/>
                                <field name="website_published" readonly="1"/>
                                <field name="website_meta_title"/>
                                <field name="website_meta_description"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_job_search" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.search</field>
        <field name="model">odex.road.mechanic.job</field>
        <field name="arch" type="xml">
            <search string="Jobs">
                <field name="name"/>
                <field name="workshop_id"/>
                <field name="job_category_id"/>
                <field name="skill_ids"/>
                <filter name="filter_pending" string="Pending Approval"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <filter name="filter_featured" string="Featured"
                        domain="[('is_featured', '=', True)]"/>
                <filter name="filter_closed" string="Closed or Expired"
                        domain="[('state', 'in', ('closed', 'expired'))]"/>
                <separator/>
                <filter name="filter_deadline" string="Deadline Passed"
                        domain="[('application_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'workshop_id'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'job_category_id'}"/>
                    <filter name="group_type" string="Job Type"
                            context="{'group_by': 'job_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_job_application_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.application.list</field>
        <field name="model">odex.road.mechanic.job.application</field>
        <field name="arch" type="xml">
            <list string="Applications" decoration-info="state == 'applied'"
                  decoration-success="state == 'selected'"
                  decoration-muted="state in ('rejected', 'withdrawn')">
                <field name="name"/>
                <field name="create_date" string="Applied"/>
                <field name="applicant_name"/>
                <field name="job_id"/>
                <field name="workshop_id"/>
                <field name="phone"/>
                <field name="experience_years"/>
                <field name="current_location" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_job_application_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.application.form</field>
        <field name="model">odex.road.mechanic.job.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="applied,review,shortlisted,interview,selected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="workshop_id" readonly="1"/>
                            <field name="applicant_name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="experience_years"/>
                            <field name="current_location"/>
                            <field name="linkedin_url" widget="url"/>
                            <field name="applicant_user_id" readonly="1"/>
                            <field name="resume" filename="resume_filename"/>
                            <field name="resume_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Cover Letter">
                        <field name="cover_letter" nolabel="1"/>
                    </group>
                    <group string="Internal Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Consent">
                        <field name="consent_given" readonly="1"/>
                        <field name="consent_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_job_application_search" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.application.search</field>
        <field name="model">odex.road.mechanic.job.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="applicant_name"/>
                <field name="job_id"/>
                <field name="workshop_id"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'applied')]"/>
                <filter name="filter_shortlisted" string="Shortlisted"
                        domain="[('state', '=', 'shortlisted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_job" string="Job" context="{'group_by': 'job_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Rejection wizard: a reason is mandatory -->
    <record id="view_job_reject_wizard_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.reject.form</field>
        <field name="model">odex.road.mechanic.job.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Job">
                <group>
                    <field name="job_ids" invisible="1"/>
                    <field name="reason" placeholder="Explain what needs to change..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_job_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Job</field>
        <field name="res_model">odex.road.mechanic.job.reject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_job_all" model="ir.actions.act_window">
        <field name="name">All Jobs</field>
        <field name="res_model">odex.road.mechanic.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_job_search"/>
    </record>

    <record id="action_job_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">odex.road.mechanic.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
    </record>

    <record id="action_job_published" model="ir.actions.act_window">
        <field name="name">Published Jobs</field>
        <field name="res_model">odex.road.mechanic.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'published')]</field>
    </record>

    <record id="action_job_featured" model="ir.actions.act_window">
        <field name="name">Featured Jobs</field>
        <field name="res_model">odex.road.mechanic.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_featured', '=', True)]</field>
    </record>

    <record id="action_job_closed" model="ir.actions.act_window">
        <field name="name">Closed Jobs</field>
        <field name="res_model">odex.road.mechanic.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('closed', 'expired', 'rejected'))]</field>
    </record>

    <record id="action_job_application" model="ir.actions.act_window">
        <field name="name">Job Applications</field>
        <field name="res_model">odex.road.mechanic.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_job_application_search"/>
    </record>

    <record id="action_job_category" model="ir.actions.act_window">
        <field name="name">Job Categories</field>
        <field name="res_model">odex.road.mechanic.job.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_job_skill" model="ir.actions.act_window">
        <field name="name">Job Skills</field>
        <field name="res_model">odex.road.mechanic.job.skill</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_job_category_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.category.list</field>
        <field name="model">odex.road.mechanic.job.category</field>
        <field name="arch" type="xml">
            <list string="Job Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="job_count" string="Published Jobs"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_job_skill_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.job.skill.list</field>
        <field name="model">odex.road.mechanic.job.skill</field>
        <field name="arch" type="xml">
            <list string="Job Skills" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_road_mechanic_jobs" name="Jobs" parent="menu_road_mechanic_root"
              sequence="34"/>
    <menuitem id="menu_jobs_all" name="All Jobs" parent="menu_road_mechanic_jobs"
              action="action_job_all" sequence="1"/>
    <menuitem id="menu_jobs_pending" name="Pending Approval" parent="menu_road_mechanic_jobs"
              action="action_job_pending" sequence="10"/>
    <menuitem id="menu_jobs_published" name="Published" parent="menu_road_mechanic_jobs"
              action="action_job_published" sequence="20"/>
    <menuitem id="menu_jobs_featured" name="Featured" parent="menu_road_mechanic_jobs"
              action="action_job_featured" sequence="30"/>
    <menuitem id="menu_jobs_closed" name="Closed" parent="menu_road_mechanic_jobs"
              action="action_job_closed" sequence="40"/>
    <menuitem id="menu_jobs_applications" name="Applications" parent="menu_road_mechanic_jobs"
              action="action_job_application" sequence="50"/>
    <menuitem id="menu_config_job_categories" name="Job Categories"
              parent="menu_road_mechanic_configuration" action="action_job_category"
              sequence="20"/>
    <menuitem id="menu_config_job_skills" name="Job Skills"
              parent="menu_road_mechanic_configuration" action="action_job_skill"
              sequence="25"/>

    <record id="menu_website_jobs" model="website.menu">
        <field name="name">Jobs</field>
        <field name="url">/jobs</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">25</field>
    </record>

</odoo>
