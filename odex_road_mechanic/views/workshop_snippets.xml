<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Star rating display -->
    <template id="orm_stars" name="Road Mechanic Stars">
        <span class="orm-stars" t-att-aria-label="'Rating %s out of 5' % (round(rating_value or 0, 1))">
            <t t-foreach="[1, 2, 3, 4, 5]" t-as="star">
                <i t-attf-class="fa #{(rating_value or 0) &gt;= star and 'fa-star' or ((rating_value or 0) &gt;= star - 0.5 and 'fa-star-half-o' or 'fa-star-o')}"/>
            </t>
            <span class="orm-stars__value" t-out="'%.1f' % (rating_value or 0)"/>
            <span class="orm-stars__count">
                (<t t-out="review_total or 0"/> <t t-out="(review_total or 0) == 1 and 'review' or 'reviews'"/>)
            </span>
        </span>
    </template>

    <!-- Verified badge -->
    <template id="orm_verified_badge" name="Road Mechanic Verified Badge">
        <span class="orm-badge orm-badge--verified" t-if="workshop.is_verified">
            <i class="fa fa-check-circle" role="img" aria-label="Verified"/> Verified
        </span>
        <span class="orm-badge orm-badge--listed" t-else="">Listed</span>
    </template>

    <!-- Theme toggle -->
    <template id="orm_theme_toggle" name="Road Mechanic Theme Toggle">
        <button type="button" class="orm-theme-toggle" data-orm-theme-toggle="1"
                aria-label="Switch between light and dark theme" title="Switch theme">
            <i class="fa fa-moon-o orm-theme-toggle__dark"/>
            <i class="fa fa-sun-o orm-theme-toggle__light"/>
            <span class="orm-theme-toggle__label">Theme</span>
        </button>
    </template>

    <!-- Search bar used on the hero and on the listing page -->
    <template id="orm_search_bar" name="Road Mechanic Search Bar">
        <form class="orm-search" action="/workshops" method="get" role="search">
            <div class="orm-search__field">
                <label class="orm-search__label" for="orm-search-input">Workshop or service</label>
                <i class="fa fa-search orm-search__icon" aria-hidden="true"/>
                <input id="orm-search-input" type="search" name="search" class="orm-search__input"
                       placeholder="Search workshop or service..." autocomplete="off"
                       data-orm-suggest="1" t-att-value="options.get('search') or ''"/>
                <div class="orm-suggest" data-orm-suggest-box="1"/>
            </div>
            <div class="orm-search__field">
                <label class="orm-search__label" for="orm-search-location">Location</label>
                <i class="fa fa-map-marker orm-search__icon" aria-hidden="true"/>
                <select id="orm-search-location" name="location_id" class="orm-search__input">
                    <option value="">Location / Area</option>
                    <t t-foreach="orm_locations" t-as="location">
                        <option t-att-value="location.id"
                                t-att-selected="options.get('location_id') == location.id and 'selected' or None">
                            <t t-out="location.display_name"/>
                        </option>
                    </t>
                </select>
            </div>
            <div class="orm-search__field">
                <label class="orm-search__label" for="orm-search-type">Vehicle type</label>
                <i class="fa fa-car orm-search__icon" aria-hidden="true"/>
                <select id="orm-search-type" name="type_id" class="orm-search__input">
                    <option value="">Vehicle Type</option>
                    <t t-foreach="orm_types" t-as="wtype">
                        <option t-att-value="wtype.id"
                                t-att-selected="options.get('type_id') == wtype.id and 'selected' or None">
                            <t t-out="wtype.name"/>
                        </option>
                    </t>
                </select>
            </div>
            <button type="submit" class="orm-btn orm-btn--primary orm-search__submit">
                <i class="fa fa-search" aria-hidden="true"/> Search
            </button>
        </form>
    </template>

    <!-- Service category strip -->
    <template id="orm_service_strip" name="Road Mechanic Service Strip">
        <nav class="orm-services" aria-label="Service categories">
            <a href="/workshops" class="orm-services__item orm-services__item--active">
                <span class="orm-services__icon"><i class="fa fa-car"/></span>
                <span class="orm-services__name">All</span>
            </a>
            <t t-foreach="orm_home_services" t-as="service">
                <a t-attf-href="/service/#{service.slug}" class="orm-services__item">
                    <span class="orm-services__icon">
                        <i t-attf-class="fa #{service.icon or 'fa-wrench'}"/>
                    </span>
                    <span class="orm-services__name" t-out="service.name"/>
                </a>
            </t>
            <a href="/services" class="orm-services__item">
                <span class="orm-services__icon"><i class="fa fa-ellipsis-h"/></span>
                <span class="orm-services__name">More</span>
            </a>
        </nav>
    </template>

    <!-- Contact action buttons -->
    <template id="orm_contact_buttons" name="Road Mechanic Contact Buttons">
        <div class="orm-actions">
            <a t-if="workshop.call_number()" t-attf-href="tel:#{workshop.call_number()}"
               class="orm-btn orm-btn--primary orm-btn--sm">
                <i class="fa fa-phone" aria-hidden="true"/> Call
            </a>
            <a t-if="workshop.whatsapp_url" t-att-href="workshop.whatsapp_url"
               target="_blank" rel="noopener" class="orm-btn orm-btn--whatsapp orm-btn--sm">
                <i class="fa fa-whatsapp" aria-hidden="true"/> WhatsApp
            </a>
        </div>
    </template>

    <!-- Workshop card (grid) -->
    <template id="orm_workshop_card" name="Road Mechanic Workshop Card">
        <article class="orm-card">
            <a class="orm-card__media" t-attf-href="/workshop/#{workshop.slug}">
                <img t-att-src="workshop.image_url('main_image')" loading="lazy"
                     t-att-alt="workshop.name"/>
                <span class="orm-card__badge">
                    <t t-call="odex_road_mechanic.orm_verified_badge"/>
                </span>
                <span class="orm-card__offer" t-if="workshop.offer_badge"
                      t-out="workshop.offer_badge"/>
                <span class="orm-card__status" t-if="workshop.is_open">
                    <span class="orm-dot orm-dot--open"/> Open now
                </span>
            </a>
            <div class="orm-card__body">
                <h3 class="orm-card__title">
                    <a t-attf-href="/workshop/#{workshop.slug}" t-out="workshop.name"/>
                </h3>
                <p class="orm-card__meta" t-if="workshop.location_id or workshop.area">
                    <i class="fa fa-map-marker" aria-hidden="true"/>
                    <t t-out="workshop.location_id.display_name or workshop.area"/>
                </p>
                <div class="orm-card__rating">
                    <t t-set="rating_value" t-value="workshop.rating"/>
                    <t t-set="review_total" t-value="workshop.review_count"/>
                    <t t-call="odex_road_mechanic.orm_stars"/>
                </div>
                <ul class="orm-tags" t-if="workshop.service_ids">
                    <li class="orm-tag" t-foreach="workshop.service_ids[:3]" t-as="service"
                        t-out="service.name"/>
                    <li class="orm-tag orm-tag--more" t-if="len(workshop.service_ids) &gt; 3">
                        +<t t-out="len(workshop.service_ids) - 3"/>
                    </li>
                </ul>
                <a t-attf-href="/workshop/#{workshop.slug}" class="orm-btn orm-btn--outline orm-btn--block">
                    View details <i class="fa fa-arrow-right" aria-hidden="true"/>
                </a>
                <t t-call="odex_road_mechanic.orm_contact_buttons"/>
            </div>
        </article>
    </template>

    <!-- Workshop row (list layout) -->
    <template id="orm_workshop_row" name="Road Mechanic Workshop Row">
        <article class="orm-row">
            <a class="orm-row__media" t-attf-href="/workshop/#{workshop.slug}">
                <img t-att-src="workshop.image_url('main_image')" loading="lazy"
                     t-att-alt="workshop.name"/>
            </a>
            <div class="orm-row__body">
                <h3 class="orm-row__title">
                    <a t-attf-href="/workshop/#{workshop.slug}" t-out="workshop.name"/>
                    <t t-call="odex_road_mechanic.orm_verified_badge"/>
                    <span class="orm-badge orm-badge--offer" t-if="workshop.offer_badge"
                          t-out="workshop.offer_badge"/>
                </h3>
                <p class="orm-row__meta" t-if="workshop.location_id or workshop.area">
                    <i class="fa fa-map-marker" aria-hidden="true"/>
                    <t t-out="workshop.location_id.display_name or workshop.area"/>
                </p>
                <div class="orm-row__rating">
                    <t t-set="rating_value" t-value="workshop.rating"/>
                    <t t-set="review_total" t-value="workshop.review_count"/>
                    <t t-call="odex_road_mechanic.orm_stars"/>
                </div>
                <ul class="orm-tags" t-if="workshop.service_ids">
                    <li class="orm-tag" t-foreach="workshop.service_ids[:4]" t-as="service"
                        t-out="service.name"/>
                </ul>
            </div>
            <div class="orm-row__hours">
                <p class="orm-row__status">
                    <span t-attf-class="orm-dot #{workshop.is_open and 'orm-dot--open' or 'orm-dot--closed'}"/>
                    <t t-out="workshop.is_open and 'Open Now' or 'Closed'"/>
                </p>
                <p class="orm-row__time" t-if="workshop.working_hours">
                    <i class="fa fa-clock-o" aria-hidden="true"/>
                    <t t-out="workshop.working_hours"/>
                </p>
                <p class="orm-row__time" t-elif="not workshop.open_24h">
                    <i class="fa fa-clock-o" aria-hidden="true"/>
                    <t t-out="'%02d:%02d' % (int(workshop.opening_time), round((workshop.opening_time % 1) * 60))"/>
                    -
                    <t t-out="'%02d:%02d' % (int(workshop.closing_time), round((workshop.closing_time % 1) * 60))"/>
                </p>
                <p class="orm-row__phone" t-if="workshop.call_number()">
                    <i class="fa fa-phone" aria-hidden="true"/>
                    <t t-out="workshop.call_number()"/>
                </p>
            </div>
            <div class="orm-row__actions">
                <a t-attf-href="/workshop/#{workshop.slug}" class="orm-btn orm-btn--outline orm-btn--sm">
                    View details <i class="fa fa-arrow-right" aria-hidden="true"/>
                </a>
                <a t-if="workshop.call_number()" t-attf-href="tel:#{workshop.call_number()}"
                   class="orm-btn orm-btn--primary orm-btn--sm">
                    <i class="fa fa-phone" aria-hidden="true"/> Call
                </a>
                <a t-if="workshop.whatsapp_url" t-att-href="workshop.whatsapp_url"
                   target="_blank" rel="noopener" class="orm-btn orm-btn--whatsapp orm-btn--sm">
                    <i class="fa fa-whatsapp" aria-hidden="true"/> WhatsApp
                </a>
            </div>
        </article>
    </template>

    <!-- Filter panel (sidebar on desktop, drawer on mobile) -->
    <template id="orm_filters" name="Road Mechanic Filters">
        <form class="orm-filters" action="/workshops" method="get" data-orm-filters="1">
            <div class="orm-filters__head">
                <h2 class="orm-filters__title"><i class="fa fa-filter" aria-hidden="true"/> Filters</h2>
                <a href="/workshops" class="orm-filters__clear">Clear all</a>
                <button type="button" class="orm-filters__close" data-orm-filters-close="1"
                        aria-label="Close filters">
                    <i class="fa fa-times"/>
                </button>
            </div>
            <input type="hidden" name="search" t-att-value="options.get('search') or ''"/>
            <input type="hidden" name="sort" t-att-value="options.get('sort') or 'recommended'"/>
            <input type="hidden" name="view" t-att-value="options.get('view') or 'grid'"/>

            <div class="orm-filters__group">
                <label class="orm-filters__label" for="orm-filter-emirate">Emirate</label>
                <select id="orm-filter-emirate" name="emirate" class="orm-input">
                    <option value="">All emirates</option>
                    <t t-foreach="orm_emirates" t-as="emirate">
                        <option t-att-value="emirate[0]"
                                t-att-selected="options.get('emirate') == emirate[0] and 'selected' or None">
                            <t t-out="emirate[1]"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="orm-filters__group">
                <label class="orm-filters__label" for="orm-filter-area">Area</label>
                <select id="orm-filter-area" name="location_id" class="orm-input">
                    <option value="">Select area</option>
                    <t t-foreach="orm_locations" t-as="location">
                        <option t-att-value="location.id"
                                t-att-selected="options.get('location_id') == location.id and 'selected' or None">
                            <t t-out="location.display_name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="orm-filters__group">
                <span class="orm-filters__label">Workshop type</span>
                <select name="type_id" class="orm-input" aria-label="Workshop type">
                    <option value="">All types</option>
                    <t t-foreach="orm_types" t-as="wtype">
                        <option t-att-value="wtype.id"
                                t-att-selected="options.get('type_id') == wtype.id and 'selected' or None">
                            <t t-out="wtype.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="orm-filters__group">
                <span class="orm-filters__label">Services</span>
                <div class="orm-checklist">
                    <t t-foreach="orm_services[:12]" t-as="service">
                        <label class="orm-check">
                            <input type="checkbox" name="service" t-att-value="service.id"
                                   t-att-checked="service.id in (active_service_ids or []) and 'checked' or None"/>
                            <span t-out="service.name"/>
                        </label>
                    </t>
                </div>
            </div>

            <div class="orm-filters__group">
                <label class="orm-filters__label" for="orm-filter-brand">Vehicle brand</label>
                <select id="orm-filter-brand" name="brand_id" class="orm-input">
                    <option value="">All brands</option>
                    <t t-foreach="orm_brands" t-as="brand">
                        <option t-att-value="brand.id"
                                t-att-selected="options.get('brand_id') == brand.id and 'selected' or None">
                            <t t-out="brand.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="orm-filters__group">
                <label class="orm-filters__label" for="orm-filter-rating">Rating</label>
                <select id="orm-filter-rating" name="min_rating" class="orm-input">
                    <option value="">Any rating</option>
                    <t t-foreach="[4.5, 4, 3.5, 3]" t-as="value">
                        <option t-att-value="value"
                                t-att-selected="options.get('min_rating') == value and 'selected' or None">
                            <t t-out="value"/> &amp; above
                        </option>
                    </t>
                </select>
            </div>

            <div class="orm-filters__group orm-filters__group--switches">
                <label class="orm-switch">
                    <span>Verified only</span>
                    <input type="checkbox" name="verified" value="1"
                           t-att-checked="options.get('verified') and 'checked' or None"/>
                    <span class="orm-switch__track"><span class="orm-switch__thumb"/></span>
                </label>
                <label class="orm-switch">
                    <span>Open now</span>
                    <input type="checkbox" name="open_now" value="1"
                           t-att-checked="options.get('open_now') and 'checked' or None"/>
                    <span class="orm-switch__track"><span class="orm-switch__thumb"/></span>
                </label>
                <label class="orm-switch">
                    <span>Featured only</span>
                    <input type="checkbox" name="featured" value="1"
                           t-att-checked="options.get('featured') and 'checked' or None"/>
                    <span class="orm-switch__track"><span class="orm-switch__thumb"/></span>
                </label>
            </div>

            <button type="submit" class="orm-btn orm-btn--primary orm-btn--block">Apply filters</button>
        </form>
    </template>

    <!-- Register CTA -->
    <template id="orm_register_cta" name="Road Mechanic Register CTA">
        <section class="orm-cta">
            <div class="orm-cta__inner">
                <div>
                    <h2 class="orm-cta__title">Own a workshop?</h2>
                    <p class="orm-cta__text">
                        List your workshop on Road Mechanic, get verified and reach car owners
                        across the UAE.
                    </p>
                </div>
                <a href="/register-workshop" class="orm-btn orm-btn--primary orm-btn--lg">
                    Register your workshop
                </a>
            </div>
        </section>
    </template>

    <!-- Empty state -->
    <template id="orm_empty_state" name="Road Mechanic Empty State">
        <div class="orm-empty">
            <img src="/odex_road_mechanic/static/src/img/road_mechanic_mark.png" alt="Road Mechanic"
                 class="orm-empty__mark"/>
            <h3 class="orm-empty__title" t-out="empty_title"/>
            <p class="orm-empty__text" t-out="empty_text"/>
            <a t-att-href="empty_url" class="orm-btn orm-btn--outline" t-out="empty_action"/>
        </div>
    </template>

</odoo>
