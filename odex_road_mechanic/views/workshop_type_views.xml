<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workshop_type_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.workshop.type.list</field>
        <field name="model">odex.road.mechanic.workshop.type</field>
        <field name="arch" type="xml">
            <list string="Workshop Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="slug" readonly="1"/>
                <field name="workshop_count" string="Workshops"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_type_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.workshop.type.form</field>
        <field name="model">odex.road.mechanic.workshop.type</field>
        <field name="arch" type="xml">
            <form string="Workshop Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workshops" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="workshop_count" widget="statinfo" string="Workshops"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Body Shop"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="icon"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="slug"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workshop_type" model="ir.actions.act_window">
        <field name="name">Workshop Types</field>
        <field name="res_model">odex.road.mechanic.workshop.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
