<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vehicle_brand_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.vehicle.brand.list</field>
        <field name="model">odex.road.mechanic.vehicle.brand</field>
        <field name="arch" type="xml">
            <list string="Vehicle Brands" editable="bottom">
                <header>
                    <button name="action_import_fleet_logos" type="object"
                            string="Import logos from Fleet" class="btn-secondary"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug" readonly="1"/>
                <field name="workshop_count" string="Workshops"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_brand_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.vehicle.brand.form</field>
        <field name="model">odex.road.mechanic.vehicle.brand</field>
        <field name="arch" type="xml">
            <form string="Vehicle Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Toyota"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="slug"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_brand" model="ir.actions.act_window">
        <field name="name">Vehicle Brands</field>
        <field name="res_model">odex.road.mechanic.vehicle.brand</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
