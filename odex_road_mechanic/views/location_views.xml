<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_location_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.location.list</field>
        <field name="model">odex.road.mechanic.location</field>
        <field name="arch" type="xml">
            <list string="Locations" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="city"/>
                <field name="emirate"/>
                <field name="slug" readonly="1"/>
                <field name="workshop_count" string="Workshops"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_location_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.location.form</field>
        <field name="model">odex.road.mechanic.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workshops" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="workshop_count" widget="statinfo" string="Workshops"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Area"/>
                        <h1><field name="name" placeholder="e.g. Al Quoz"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="city"/>
                            <field name="emirate"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="slug"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="SEO">
                        <field name="website_meta_title"/>
                        <field name="website_meta_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">odex.road.mechanic.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
