<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_notification_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.notification.list</field>
        <field name="model">odex.road.mechanic.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications" create="false">
                <field name="create_date" string="Sent"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="title"/>
                <field name="body"/>
                <field name="request_id"/>
                <field name="is_read" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">odex.road.mechanic.notification</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
