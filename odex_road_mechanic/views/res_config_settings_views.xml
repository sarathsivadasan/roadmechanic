<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_road_mechanic" model="ir.ui.view">
        <field name="name">res.config.settings.road.mechanic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Road Mechanic Directory" name="orm_directory_settings">
                    <setting id="orm_homepage_setting" string="Road Mechanic as Homepage"
                             help="Serve the Road Mechanic directory on '/' instead of the standard website homepage.">
                        <field name="orm_is_homepage"/>
                    </setting>
                    <setting id="orm_page_size_setting" string="Workshops per Page"
                             help="Number of workshops loaded on each page of the directory.">
                        <field name="orm_listing_page_size"/>
                    </setting>
                    <setting id="orm_hero_setting" string="Directory Hero Image"
                             help="Background photo of the hero section. A branded placeholder is used when empty.">
                        <field name="orm_hero_image" widget="image" class="w-50"/>
                    </setting>
                    <setting id="orm_hero_overlay_setting" string="Hero Overlay Darkness"
                             help="How much the hero photo is darkened behind the heading. 0 leaves the photo untouched, 95 is almost black.">
                        <field name="orm_hero_overlay"/>
                    </setting>
                    <setting id="owms_page_setting" string="OWMS Software Page"
                             help="Title, text and images of the /software/owms page.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="owms_hero_title" class="col-lg-4 o_light_label"/>
                                <field name="owms_hero_title"/>
                            </div>
                            <div class="row">
                                <label for="owms_hero_subtitle" class="col-lg-4 o_light_label"/>
                                <field name="owms_hero_subtitle"/>
                            </div>
                            <div class="row">
                                <label for="owms_hero_text" class="col-lg-4 o_light_label"/>
                                <field name="owms_hero_text"/>
                            </div>
                            <div class="row">
                                <label for="owms_hero_image" class="col-lg-4 o_light_label"/>
                                <field name="owms_hero_image" widget="image" class="w-50"/>
                            </div>
                            <div class="row">
                                <label for="owms_devices_title" class="col-lg-4 o_light_label"/>
                                <field name="owms_devices_title"/>
                            </div>
                            <div class="row">
                                <label for="owms_devices_subtitle" class="col-lg-4 o_light_label"/>
                                <field name="owms_devices_subtitle"/>
                            </div>
                            <div class="row">
                                <label for="owms_devices_image" class="col-lg-4 o_light_label"/>
                                <field name="owms_devices_image" widget="image" class="w-50"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="orm_colors_setting" string="Brand Colours"
                             help="Hex values used across the Road Mechanic pages. Leave a field empty to keep the shipped colour.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="orm_color_primary" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_primary" placeholder="#e51b23"/>
                            </div>
                            <div class="row">
                                <label for="orm_color_accent" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_accent" placeholder="#d6b06a"/>
                            </div>
                            <div class="row">
                                <label for="orm_color_success" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_success" placeholder="#12a55b"/>
                            </div>
                            <div class="row">
                                <label for="orm_color_light_bg" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_light_bg" placeholder="#ffffff"/>
                            </div>
                            <div class="row">
                                <label for="orm_color_light_surface" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_light_surface" placeholder="#f5f6f7"/>
                            </div>
                            <div class="row">
                                <label for="orm_color_dark_bg" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_dark_bg" placeholder="#0d0d0d"/>
                            </div>
                            <div class="row">
                                <label for="orm_color_dark_surface" class="col-lg-5 o_light_label"/>
                                <field name="orm_color_dark_surface" placeholder="#171717"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="orm_contact_setting" string="Directory Contact Details"
                             help="Shown on the Road Mechanic contact page.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="orm_contact_phone" class="col-lg-4 o_light_label"/>
                                <field name="orm_contact_phone"/>
                            </div>
                            <div class="row">
                                <label for="orm_contact_whatsapp" class="col-lg-4 o_light_label"/>
                                <field name="orm_contact_whatsapp"/>
                            </div>
                            <div class="row">
                                <label for="orm_contact_email" class="col-lg-4 o_light_label"/>
                                <field name="orm_contact_email"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
