<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inquiry_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.inquiry.list</field>
        <field name="model">odex.road.mechanic.inquiry</field>
        <field name="arch" type="xml">
            <list string="Inquiries" decoration-info="state == 'new'" decoration-muted="state in ('closed', 'cancelled')">
                <field name="create_date" string="Received"/>
                <field name="workshop_id"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="service_id" optional="show"/>
                <field name="vehicle_brand_id" optional="hide"/>
                <field name="preferred_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'closed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_inquiry_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.inquiry.form</field>
        <field name="model">odex.road.mechanic.inquiry</field>
        <field name="arch" type="xml">
            <form string="Inquiry">
                <header>
                    <button name="action_set_contacted" type="object" string="Mark Contacted"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_set_in_progress" type="object" string="Start"
                            invisible="state not in ('new', 'contacted')"/>
                    <button name="action_set_closed" type="object" string="Close"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_set_cancelled" type="object" string="Cancel"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_new" type="object" string="Reset"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,contacted,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="customer_name"/>
                        <h1><field name="customer_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workshop_id"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="service_id"/>
                            <field name="vehicle_brand_id"/>
                            <field name="vehicle_model"/>
                            <field name="preferred_date"/>
                            <field name="source" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="internal_notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_inquiry_search" model="ir.ui.view">
        <field name="name">odex.road.mechanic.inquiry.search</field>
        <field name="model">odex.road.mechanic.inquiry</field>
        <field name="arch" type="xml">
            <search string="Inquiries">
                <field name="workshop_id"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_open" string="Open" domain="[('state', 'in', ('new', 'contacted', 'in_progress'))]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_workshop" string="Workshop" context="{'group_by': 'workshop_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_service" string="Service" context="{'group_by': 'service_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_inquiry" model="ir.actions.act_window">
        <field name="name">Inquiries</field>
        <field name="res_model">odex.road.mechanic.inquiry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inquiry_search"/>
    </record>

    <record id="action_inquiry_new" model="ir.actions.act_window">
        <field name="name">New Inquiries</field>
        <field name="res_model">odex.road.mechanic.inquiry</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'new')]</field>
        <field name="search_view_id" ref="view_inquiry_search"/>
    </record>

</odoo>
