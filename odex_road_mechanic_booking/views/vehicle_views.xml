<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vehicle_list" model="ir.ui.view">
        <field name="name">odex.road.mechanic.vehicle.list</field>
        <field name="model">odex.road.mechanic.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="brand_id"/>
                <field name="model_name"/>
                <field name="plate"/>
                <field name="year" optional="hide"/>
                <field name="booking_count" string="Bookings"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">odex.road.mechanic.vehicle.form</field>
        <field name="model">odex.road.mechanic.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Vehicle"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="brand_id"/>
                            <field name="model_name"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="plate"/>
                            <field name="colour"/>
                            <field name="vin"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">odex.road.mechanic.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
